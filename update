                if (lessonStep < currentUnitObj.sentences.length) {
                    renderSentenceBuilder(currentUnitObj.sentences[lessonStep]);
                } else { finishStageReward(); }
            } else if (currentStageIdx === 4) {
                if (lessonStep < currentUnitObj.quiz.length) {
                    const q = currentUnitObj.quiz[lessonStep];
                    container.innerHTML = `
                        <div class="space-y-6">
                            <div class="bg-red-500/10 border border-red-500/30 p-4 rounded-2xl">
                                <h4 class="font-black text-red-400 text-lg"><i class="fa-solid fa-dragon"></i> Đấu Boss (${lessonStep + 1}/${currentUnitObj.quiz.length})</h4>
                            </div>
                            <h3 class="text-xl font-black text-white">${q.q}</h3>
                            <div class="grid grid-cols-1 gap-3">
                                ${q.options.map((opt) => `<button onclick="checkBossAnswer(this, '${opt.replace(/'/g, "\\'")}', '${q.correctText.replace(/'/g, "\\'")}')" class="option-btn btn-duolingo w-full text-left p-4 rounded-2xl bg-[#202f36] border-2 border-gray-700 font-bold text-white"><span>${opt}</span></button>`).join('')}
                            </div>
                        </div>`;
                } else { finishStageReward(); }
            }
        }

        function checkQuizAnswer(btnEl, selectedText, correctText) {
            if (selectedText.trim() === correctText.trim()) {
                btnEl.className = "btn-duolingo w-full text-left p-4 rounded-2xl bg-emerald-600 border-2 border-emerald-500 font-bold text-white";
                setTimeout(() => { lessonStep++; loadStageContent(); }, 800);
            } else {
                loseHeart(); if (gameState.hearts <= 0) return;
                btnEl.className = "btn-duolingo w-full text-left p-4 rounded-2xl bg-red-600/50 border-2 border-red-500 font-bold text-white opacity-50 pointer-events-none";
                alert("❌ Chưa đúng! Hãy suy nghĩ kỹ lại nhé.");
            }
        }

        function checkBossAnswer(btnEl, selectedText, correctText) {
            if (selectedText.trim() === correctText.trim()) {
                btnEl.className = "btn-duolingo w-full text-left p-4 rounded-2xl bg-emerald-600 border-2 border-emerald-500 font-bold text-white";
                setTimeout(() => { lessonStep++; loadStageContent(); }, 800);
            } else {
                loseHeart(); if (gameState.hearts <= 0) return;
                btnEl.className = "btn-duolingo w-full text-left p-4 rounded-2xl bg-red-600/50 border-2 border-red-500 font-bold text-white opacity-50 pointer-events-none";
                alert("❌ Boss phản công! Chưa đúng, hãy thử lại.");
            }
        }

        let currentScrambled = []; let userSelectedWords = [];

        function renderSentenceBuilder(sentenceObj) {
            currentScrambled = [...sentenceObj.scrambled].sort(() => Math.random() - 0.5);
            userSelectedWords = [];
            const container = document.getElementById('lesson-content');
            container.innerHTML = `
                <div class="space-y-6">
                    <span class="text-xs font-bold text-yellow-400 uppercase">Chặng 3: Ghép câu</span>
                    <h3 class="text-lg font-black text-white">Sắp xếp các từ thành câu đúng:</h3>
                    <div id="selected-words-box" class="min-h-[60px] bg-[#202f36] border-2 border-dashed border-gray-600 rounded-2xl p-3 flex flex-wrap gap-2 items-center">
                        <span class="text-xs text-gray-500 italic">Chạm vào từ bên dưới...</span>
                    </div>
                    <div id="pool-words-box" class="flex flex-wrap gap-2 pt-2">
                        ${currentScrambled.map((w, idx) => `<button onclick="pickWord('${w.replace(/'/g, "\\'")}', ${idx})" id="pool-word-${idx}" class="btn-duolingo bg-gray-800 border border-gray-600 px-4 py-2 rounded-xl font-bold text-white text-sm">${w}</button>`).join('')}
                    </div>
                    <button onclick="checkSentenceResult('${sentenceObj.correct.replace(/'/g, "\\'")}')" class="btn-duolingo w-full bg-emerald-600 text-white font-black py-3.5 rounded-2xl text-lg">Kiểm tra ➔</button>
                </div>`;
        }

        function pickWord(word, idx) {
            userSelectedWords.push({ word, idx });
            document.getElementById(`pool-word-${idx}`).classList.add('opacity-30', 'pointer-events-none');
            updateSelectedWordsBox();
        }

        function updateSelectedWordsBox() {
            const box = document.getElementById('selected-words-box');
            if (userSelectedWords.length === 0) {
                box.innerHTML = `<span class="text-xs text-gray-500 italic">Chạm vào từ bên dưới...</span>`;
            } else {
                box.innerHTML = userSelectedWords.map((item, sIdx) => `<button onclick="returnWord(${sIdx}, ${item.idx})" class="btn-duolingo bg-emerald-600 px-3 py-1.5 rounded-xl font-bold text-white text-sm">${item.word}</button>`).join('');
            }
        }

        function returnWord(selectedIdx, poolIdx) {
            userSelectedWords.splice(selectedIdx, 1);
            document.getElementById(`pool-word-${poolIdx}`).classList.remove('opacity-30', 'pointer-events-none');
            updateSelectedWordsBox();
        }

        function checkSentenceResult(correctSentence) {
            const userSentence = userSelectedWords.map(i => i.word).join(' ').trim();
            const cleanUser = userSentence.replace(/[.!?]$/, "").toLowerCase();
            const cleanCorrect = correctSentence.replace(/[.!?]$/, "").toLowerCase();

            if (cleanUser === cleanCorrect) {
                alert("Chính xác! 🎉"); lessonStep++; loadStageContent();
            } else {
                loseHeart(); if (gameState.hearts <= 0) return;
                alert("❌ Chưa đúng! Hãy suy nghĩ và sắp xếp lại nhé.");
            }
        }

        function finishStageReward() {
            gameState.xp += 25; gameState.coins += 10;
            let bonusText = "";
            if (heartsLostInThisLesson === 0) {
                gameState.hearts = Math.min(gameState.maxHearts, gameState.hearts + 1);
                gameState.coins += 15;
                bonusText = "<br><span class='text-yellow-400 font-bold'>✨ Thưởng hoàn hảo: +1 Tim ❤️ & +15 Vàng 🪙!</span>";
            }
            if (gameState.xp >= gameState.level * 100) {
                gameState.level++;
                bonusText += `<br><span class='text-purple-400 font-bold'>🚀 Lên Cấp độ ${gameState.level}!</span>`;
            }

            const grade = gameState.currentGrade;
            if(!gameState.completedUnits[grade]) gameState.completedUnits[grade] = [];

            if (currentStageIdx === 4 && !gameState.completedUnits[grade].includes(currentUnitObj.id)) {
                gameState.completedUnits[grade].push(currentUnitObj.id);
            }

            saveState(); confetti({ particleCount: 100, spread: 70, origin: { y: 0.6 } });

            document.getElementById('lesson-content').innerHTML = `
                <div class="text-center space-y-6">
                    <div class="w-24 h-24 bg-yellow-500 rounded-full mx-auto flex items-center justify-center text-4xl text-gray-900 shadow-xl animate-bounce">
                        <i class="fa-solid fa-trophy"></i>
                    </div>
                    <div>
                        <h2 class="text-2xl font-black text-white">Hoàn Thành Xuất Sắc Chặng Này!</h2>
                        <p class="text-sm text-emerald-400 mt-1">${currentUnitObj.title}</p>
                        <p class="text-xs text-gray-400 mt-2">+25 XP | +10 Vàng ${bonusText}</p>
                    </div>
                    <button onclick="closeLesson()" class="btn-duolingo w-full max-w-sm mx-auto bg-emerald-600 text-white font-black py-4 rounded-2xl text-lg">Hoàn thành ✔</button>
                </div>`;
        }

        switchGrade(9);
    </script>
</body>
</html>
