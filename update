            const reader = new FileReader();
            reader.onload = function(e) {
                const content = e.target.result;
                document.getElementById('custom-title').value = file.name.replace(/\.[^/.]+$/, "");
                
                // Phân tách thông minh nội dung file
                const lines = content.split('\n').map(l => l.trim()).filter(l => l);
                let vocabLines = [];
                let sentenceLines = [];
                
                lines.forEach(line => {
                    if (line.includes(' - ') && line.split(' - ')[0].split(' ').length <= 3) {
                        vocabLines.push(line);
                    } else if (!line.includes('?') && !line.includes('_') && line.split(' ').length >= 4 && line.split(' ').length <= 12) {
                        sentenceLines.push(line);
                    }
                });

                if (vocabLines.length > 0) document.getElementById('custom-vocab').value = vocabLines.join('\n');
                if (sentenceLines.length > 0) document.getElementById('custom-sentences').value = sentenceLines.slice(0, 5).join('\n');
                
                // Đưa phần còn lại vào khung trắc nghiệm để người dùng kiểm tra
                document.getElementById('custom-quiz').value = content;
                alert("✅ Đã tải nội dung file lên! Bạn có thể kiểm tra lại các mục rồi bấm 'Tạo Bài Học Mới Ngay'.");
            };
            reader.readAsText(file);
        }

