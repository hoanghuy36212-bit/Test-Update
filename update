<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>English 6-9 Quest - Global Success & Custom AI</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap');
        body { font-family: 'Nunito', sans-serif; background-color: #131f24; color: #e5e7eb; user-select: none; }
        .game-card { background: #202f36; border: 2px solid #374151; border-radius: 1rem; transition: all 0.2s; }
        .game-card:hover { border-color: #4b5563; }
        .btn-duolingo { transition: all 0.1s ease; box-shadow: 0 4px 0 0 rgba(0,0,0,0.3); }
        .btn-duolingo:active { transform: translateY(4px); box-shadow: 0 0 0 0 rgba(0,0,0,0.3); }
        .flip-card { perspective: 1000px; }
        .flip-card-inner { transition: transform 0.6s; transform-style: preserve-3d; }
        .flip-card.flipped .flip-card-inner { transform: rotateY(180deg); }
        .flip-card-front, .flip-card-back { backface-visibility: hidden; position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
        .flip-card-back { transform: rotateY(180deg); }
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #131f24; }
        ::-webkit-scrollbar-thumb { background: #374151; border-radius: 4px; }
    </style>
</head>
<body class="min-h-screen pb-24">

    <!-- TOP HUD BAR -->
    <header class="sticky top-0 z-50 bg-[#131f24]/95 backdrop-blur border-b border-gray-800 px-4 py-3">
        <div class="max-w-4xl mx-auto flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="bg-emerald-500 text-white font-black px-3 py-1 rounded-xl text-lg shadow-lg flex items-center gap-1">
                    <i class="fa-solid fa-graduation-cap"></i> E6-9
                </div>
                <div>
                    <h1 class="font-extrabold text-sm sm:text-base text-gray-200">English Quest</h1>
                    <span class="text-xs text-emerald-400 font-bold">Global Success + Custom</span>
                </div>
            </div>

            <div class="flex items-center space-x-3 sm:space-x-5 text-sm font-bold">
                <div class="flex items-center gap-2 bg-gray-800/80 px-3 py-1.5 rounded-full border border-gray-700">
                    <span id="level-badge" class="bg-purple-600 text-white text-xs px-2 py-0.5 rounded-full">Lv.1</span>
                    <div class="w-12 sm:w-20 bg-gray-700 h-2 rounded-full overflow-hidden">
                        <div id="xp-bar" class="bg-purple-500 h-full w-0 transition-all duration-300"></div>
                    </div>
                </div>

                <div class="flex items-center gap-1 text-orange-400" title="Chuỗi ngày">
                    <i class="fa-solid fa-fire"></i>
                    <span id="streak-count">1</span>
                </div>

                <div class="flex items-center gap-1 text-yellow-400" title="Xu vàng">
                    <i class="fa-solid fa-coins"></i>
                    <span id="coins-count">60</span>
                </div>

                <div class="flex items-center gap-1 text-red-500" title="Tim">
                    <i class="fa-solid fa-heart"></i>
                    <span id="hearts-count">10</span>
                </div>

                <button onclick="toggleAudio()" id="audio-btn" class="text-gray-400 hover:text-white transition">
                    <i class="fa-solid fa-volume-high text-lg"></i>
                </button>
            </div>
        </div>
    </header>

    <!-- MAIN CONTAINER -->
    <main class="max-w-4xl mx-auto px-4 mt-6">
        
        <!-- MAP VIEW -->
        <div id="view-map-wrapper">
            <!-- CHỌN KHỐI LỚP & HỌC KỲ -->
            <div class="bg-[#202f36] p-4 rounded-2xl border border-gray-800 mb-6 space-y-3">
                <div class="flex flex-col sm:flex-row justify-between items-center gap-3">
                    <div>
                        <h2 class="text-lg font-bold text-white flex items-center gap-2">
                            <i class="fa-solid fa-map-location-dot text-emerald-400"></i> Bản Đồ Chinh Phục
                        </h2>
                        <p class="text-xs text-gray-400">Hoàn thành đủ 4 chặng để mở khóa Unit tiếp theo</p>
                    </div>
                    <div class="flex flex-wrap gap-1.5 bg-gray-900/60 p-1.5 rounded-xl border border-gray-700 justify-center">
                        <button onclick="switchGrade(6)" id="btn-grade-6" class="px-3 py-1 text-xs font-bold rounded-lg bg-gray-800 text-gray-300 transition">Lớp 6</button>
                        <button onclick="switchGrade(7)" id="btn-grade-7" class="px-3 py-1 text-xs font-bold rounded-lg bg-gray-800 text-gray-300 transition">Lớp 7</button>
                        <button onclick="switchGrade(8)" id="btn-grade-8" class="px-3 py-1 text-xs font-bold rounded-lg bg-gray-800 text-gray-300 transition">Lớp 8</button>
                        <button onclick="switchGrade(9)" id="btn-grade-9" class="px-3 py-1 text-xs font-bold rounded-lg bg-emerald-600 text-white transition">Lớp 9</button>
                        <button onclick="switchGrade('custom')" id="btn-grade-custom" class="px-3 py-1 text-xs font-bold rounded-lg bg-purple-700 text-white transition flex items-center gap-1">
                            <i class="fa-solid fa-wand-magic-sparkles"></i> Đề Của Tôi
                        </button>
                    </div>
                </div>

                <div id="semester-filter-bar" class="flex justify-between items-center pt-2 border-t border-gray-800">
                    <div class="flex gap-2">
                        <button onclick="filterSemester(1)" id="btn-sem-1" class="px-3 py-1.5 text-xs font-bold rounded-xl bg-emerald-600 text-white transition">Học kỳ I</button>
                        <button onclick="filterSemester(2)" id="btn-sem-2" class="px-3 py-1.5 text-xs font-bold rounded-xl bg-gray-700 text-gray-300 transition">Học kỳ II</button>
                    </div>
                    <button onclick="switchTab('upload')" class="text-xs font-bold text-purple-400 hover:text-purple-300 flex items-center gap-1">
                        <i class="fa-solid fa-plus-circle"></i> Tạo bài từ đề riêng
                    </button>
                </div>
            </div>

            <div id="view-map" class="space-y-6"></div>
        </div>

        <!-- UPLOAD / CUSTOM LESSON CREATOR VIEW -->
        <div id="view-upload" class="hidden space-y-6">
            <div class="bg-[#202f36] p-6 rounded-2xl border border-gray-800 space-y-4">
                <div class="flex items-center justify-between">
                    <div>
                        <h2 class="text-xl font-black text-white flex items-center gap-2">
                            <i class="fa-solid fa-file-arrow-up text-purple-400"></i> Tạo Bài Học Từ Đề Của Bạn
                        </h2>
                        <p class="text-xs text-gray-400 mt-1">Tải lên file đề (.txt) hoặc dán nội dung bên dưới để hệ thống tự động tạo game 4 chặng.</p>
                    </div>
                    <label class="cursor-pointer btn-duolingo bg-purple-600 hover:bg-purple-500 text-white text-xs font-bold px-4 py-2.5 rounded-xl flex items-center gap-2">
                        <i class="fa-solid fa-folder-open"></i> Chọn File (.txt)
                        <input type="file" id="file-upload-input" accept=".txt" class="hidden" onchange="handleFileUpload(event)">
                    </label>
                </div>

                <div class="space-y-4 pt-2">
                    <div>
                        <label class="block text-xs font-bold text-gray-300 mb-1">1. Tên bài học / Đề thi:</label>
                        <input type="text" id="custom-title" placeholder="Ví dụ: Đề ôn thi giữa kỳ 1 - Tiếng Anh 9" class="w-full bg-gray-900 border border-gray-700 rounded-xl px-4 py-2.5 text-sm text-white focus:border-emerald-500 focus:outline-none">
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-gray-300 mb-1">
                            2. Danh sách Từ Vựng (Mỗi dòng 1 từ theo mẫu: <span class="text-emerald-400">từ tiếng Anh - nghĩa tiếng Việt</span>):
                        </label>
                        <textarea id="custom-vocab" rows="4" placeholder="environment - môi trường&#10;pollution - sự ô nhiễm&#10;protect - bảo vệ&#10;recycle - tái chế" class="w-full bg-gray-900 border border-gray-700 rounded-xl p-3 text-sm text-white focus:border-emerald-500 focus:outline-none font-mono"></textarea>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-gray-300 mb-1">
                            3. Câu hỏi Trắc Nghiệm (Mỗi câu cách nhau 1 dòng trống, thêm dấu <span class="text-yellow-400">*</span> trước đáp án đúng):
                        </label>
                        <textarea id="custom-quiz" rows="7" placeholder="She _____ to school every day.&#10;go&#10;*goes&#10;going&#10;is go&#10;&#10;They _____ football at the moment.&#10;play&#10;played&#10;*are playing&#10;plays" class="w-full bg-gray-900 border border-gray-700 rounded-xl p-3 text-sm text-white focus:border-emerald-500 focus:outline-none font-mono"></textarea>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-gray-300 mb-1">
                            4. Câu hoàn chỉnh cho game Ghép Câu (Mỗi dòng 1 câu tiếng Anh chuẩn):
                        </label>
                        <textarea id="custom-sentences" rows="3" placeholder="We should protect our environment.&#10;Students are studying English now." class="w-full bg-gray-900 border border-gray-700 rounded-xl p-3 text-sm text-white focus:border-emerald-500 focus:outline-none font-mono"></textarea>
                    </div>

                    <div class="flex gap-3 pt-2">
                        <button onclick="fillSampleCustomData()" class="px-4 py-3 rounded-xl bg-gray-800 hover:bg-gray-700 text-gray-300 font-bold text-xs transition">
                            Điền dữ liệu mẫu
                        </button>
                        <button onclick="createCustomUnit()" class="flex-1 btn-duolingo bg-emerald-600 hover:bg-emerald-500 text-white font-black py-3 rounded-xl text-base flex items-center justify-center gap-2">
                            <i class="fa-solid fa-wand-magic-sparkles"></i> Tạo Bài Học Mới Ngay 🚀
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- SHOP VIEW -->
        <div id="view-shop" class="hidden space-y-6">
            <div class="bg-[#202f36] p-6 rounded-2xl border border-gray-800 text-center">
                <h2 class="text-2xl font-black text-white mb-2"><i class="fa-solid fa-store text-yellow-400"></i> Cửa Hàng Vật Phẩm</h2>
                <p class="text-sm text-gray-400">Dùng xu vàng kiếm được để hồi phục tim hoặc mua trợ giúp.</p>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="game-card p-5 flex items-center justify-between">
                    <div class="flex items-center gap-4">
                        <div class="w-12 h-12 rounded-2xl bg-red-500/20 text-red-500 flex items-center justify-center text-2xl font-bold">
                            <i class="fa-solid fa-heart"></i>
                        </div>
                        <div>
                            <h3 class="font-bold text-white">Hồi Phục Đầy Tim</h3>
                            <p class="text-xs text-gray-400">Khôi phục ngay lại 10 Tim ❤️</p>
                        </div>
                    </div>
                    <button onclick="buyHearts()" class="btn-duolingo bg-yellow-500 hover:bg-yellow-400 text-gray-900 font-extrabold px-4 py-2 rounded-xl text-sm flex items-center gap-1">
                        <i class="fa-solid fa-coins"></i> 30
                    </button>
                </div>
                <div class="game-card p-5 flex items-center justify-between">
                    <div class="flex items-center gap-4">
                        <div class="w-12 h-12 rounded-2xl bg-purple-500/20 text-purple-400 flex items-center justify-center text-2xl font-bold">
                            <i class="fa-solid fa-shield-cat"></i>
                        </div>
                        <div>
                            <h3 class="font-bold text-white">Khiên Bảo Vệ Tim</h3>
                            <p class="text-xs text-gray-400">Miễn nhiễm mất tim trong bài tiếp theo</p>
                        </div>
                    </div>
                    <button onclick="buyShield()" class="btn-duolingo bg-yellow-500 hover:bg-yellow-400 text-gray-900 font-extrabold px-4 py-2 rounded-xl text-sm flex items-center gap-1">
                        <i class="fa-solid fa-coins"></i> 50
                    </button>
                </div>
            </div>
        </div>

        <!-- BADGES VIEW -->
        <div id="view-badges" class="hidden space-y-6">
            <div class="bg-[#202f36] p-6 rounded-2xl border border-gray-800 text-center">
                <h2 class="text-2xl font-black text-white mb-2"><i class="fa-solid fa-trophy text-yellow-400"></i> Phòng Trưng bày Huy Hiệu</h2>
                <p class="text-sm text-gray-400">Chinh phục các Unit để sưu tầm huy hiệu danh giá.</p>
            </div>
            <div id="badges-grid" class="grid grid-cols-2 sm:grid-cols-4 gap-4"></div>
        </div>

        <!-- PROFILE VIEW -->
        <div id="view-profile" class="hidden space-y-6">
            <div class="game-card p-6 text-center space-y-4">
                <div class="w-20 h-20 bg-emerald-500 rounded-full mx-auto flex items-center justify-center text-3xl font-black text-white shadow-xl">
                    E69
                </div>
                <div>
                    <h2 class="text-xl font-black text-white">Học Sinh Chăm Chỉ</h2>
                    <p class="text-xs text-emerald-400 font-bold">Chương trình Tiếng Anh THCS Global Success</p>
                </div>
                <div class="grid grid-cols-3 gap-3 pt-4 border-t border-gray-800 text-center">
                    <div class="bg-gray-800/50 p-3 rounded-xl">
                        <span id="prof-score" class="block text-xl font-black text-yellow-400">0</span>
                        <span class="text-xs text-gray-400">Tổng XP</span>
                    </div>
                    <div class="bg-gray-800/50 p-3 rounded-xl">
                        <span id="prof-hearts" class="block text-xl font-black text-red-500">10</span>
                        <span class="text-xs text-gray-400">Tim hiện tại</span>
                    </div>
                    <div class="bg-gray-800/50 p-3 rounded-xl">
                        <span id="prof-streak" class="block text-xl font-black text-orange-400">1</span>
                        <span class="text-xs text-gray-400">Chuỗi ngày</span>
                    </div>
                </div>
                <button onclick="resetData()" class="text-xs text-red-400 hover:text-red-300 underline pt-2">Đặt lại toàn bộ tiến trình học</button>
            </div>
        </div>

    </main>

    <!-- LESSON MODAL -->
    <div id="lesson-modal" class="fixed inset-0 z-50 bg-[#131f24] hidden flex flex-col">
        <header class="bg-[#202f36] px-4 py-3 border-b border-gray-800 flex items-center justify-between">
            <button onclick="closeLesson()" class="text-gray-400 hover:text-white text-lg px-2 py-1">
                <i class="fa-solid fa-xmark"></i> Thoát
            </button>
            <div class="w-1/2 bg-gray-700 h-3 rounded-full overflow-hidden">
                <div id="lesson-progress" class="bg-emerald-500 h-full w-0 transition-all duration-300"></div>
            </div>
            <div class="flex items-center gap-2 text-red-500 font-bold">
                <i class="fa-solid fa-heart"></i> <span id="modal-hearts">10</span>
            </div>
        </header>
        <div id="lesson-content" class="flex-1 max-w-2xl w-full mx-auto p-4 flex flex-col justify-center overflow-y-auto"></div>
    </div>

    <!-- BOTTOM NAVIGATION -->
    <nav class="fixed bottom-0 left-0 right-0 bg-[#131f24]/95 backdrop-blur border-t border-gray-800 py-2 z-40">
        <div class="max-w-md mx-auto flex justify-around">
            <button onclick="switchTab('map')" id="nav-map" class="flex flex-col items-center text-emerald-400 transition">
                <i class="fa-solid fa-map text-xl"></i>
                <span class="text-xs font-bold mt-1">Bản đồ</span>
            </button>
            <button onclick="switchTab('upload')" id="nav-upload" class="flex flex-col items-center text-gray-400 hover:text-gray-200 transition">
                <i class="fa-solid fa-file-circle-plus text-xl"></i>
                <span class="text-xs font-bold mt-1">Tạo Đề</span>
            </button>
            <button onclick="switchTab('shop')" id="nav-shop" class="flex flex-col items-center text-gray-400 hover:text-gray-200 transition">
                <i class="fa-solid fa-store text-xl"></i>
                <span class="text-xs font-bold mt-1">Cửa hàng</span>
            </button>
            <button onclick="switchTab('badges')" id="nav-badges" class="flex flex-col items-center text-gray-400 hover:text-gray-200 transition">
                <i class="fa-solid fa-trophy text-xl"></i>
                <span class="text-xs font-bold mt-1">Huy hiệu</span>
            </button>
            <button onclick="switchTab('profile')" id="nav-profile" class="flex flex-col items-center text-gray-400 hover:text-gray-200 transition">
                <i class="fa-solid fa-user text-xl"></i>
                <span class="text-xs font-bold mt-1">Hồ sơ</span>
            </button>
        </div>
    </nav>

    <script>
        const generateUnits = (gradeName, titles) => {
            return titles.map((titleData, i) => ({
                id: i + 1,
                title: `Unit ${i + 1}: ${titleData.en}`,
                vietnamese: titleData.vi,
                semester: i < 6 ? 1 : 2,
                vocab: [
                    { en: "school", vi: "trường học", phonetic: "/skuːl/", example: "My school is large." },
                    { en: "student", vi: "học sinh", phonetic: "/ˈstjuːdnt/", example: "Students study hard." },
                    { en: "teacher", vi: "giáo viên", phonetic: "/ˈtiːtʃə(r)/", example: "Our teacher is helpful." },
                    { en: "friend", vi: "bạn bè", phonetic: "/frend/", example: "Make new friends." }
                ],
                grammar: { title: `Ngữ pháp trọng tâm Unit ${i + 1}`, content: `Hệ thống cấu trúc ngữ pháp quan trọng trong chương trình ${gradeName} Global Success.` },
                quiz: [
                    { q: `Chọn dạng đúng của động từ: She _____ to school every day.`, options: ["go", "goes", "going", "is go"], correctText: "goes" },
                    { q: `Chọn từ loại phù hợp: My brother is very _____ and helpful.`, options: ["kind", "lazily", "slow", "noise"], correctText: "kind" },
                    { q: `Chọn giới từ đúng: There is a picture _____ the wall.`, options: ["in", "at", "on", "under"], correctText: "on" },
                    { q: `Chọn đáp án đúng điền vào chỗ trống: They _____ English at the moment.`, options: ["study", "studies", "are studying", "studied"], correctText: "are studying" },
                    { q: `Chọn cấu trúc so sánh đúng: This house is _____ than that one.`, options: ["big", "bigger", "biggest", "more big"], correctText: "bigger" }
                ],
                sentences: [
                    { scrambled: ["English", "learn", "We", "today"], correct: "We learn English today." },
                    { scrambled: ["school", "to", "go", "Students"], correct: "Students go to school." }
                ],
                boss: { name: `Trùm Unit ${i + 1}`, hp: 100, questions: 5 }
            }));
        };

        const titles6 = [
            { en: "My New School", vi: "Trường mới của tôi" }, { en: "My House", vi: "Ngôi nhà của tôi" },
            { en: "My Friends", vi: "Những người bạn" }, { en: "My Neighbourhood", vi: "Khu xóm của tôi" },
            { en: "Natural Wonders", vi: "Kỳ quan thiên nhiên" }, { en: "Tet Holiday", vi: "Ngày Tết nguyên đán" },
            { en: "Television", vi: "Truyền hình" }, { en: "Sports and Games", vi: "Thể thao và trò chơi" },
            { en: "Cities of the World", vi: "Các thành phố trên thế giới" }, { en: "Our Houses in the Future", vi: "Nhà ở tương lai" },
            { en: "Our Greener World", vi: "Thế giới xanh hơn" }, { en: "Robots", vi: "Người máy" }
        ];

        const titles7 = [
            { en: "Hobby", vi: "Sở thích" }, { en: "Healthy Living", vi: "Sống khỏe mạnh" },
            { en: "Community Service", vi: "Hoạt động cộng đồng" }, { en: "Music and Arts", vi: "Âm nhạc và nghệ thuật" },
            { en: "Food and Drink", vi: "Đồ ăn và thức uống" }, { en: "A Visit to a School", vi: "Thăm trường học" },
            { en: "Saving Energy", vi: "Tiết kiệm năng lượng" }, { en: "Festivals Around", vi: "Lễ hội xung quanh" },
            { en: "English in the World", vi: "Tiếng Anh trên thế giới" }, { en: "Energy Sources", vi: "Nguồn năng lượng" },
            { en: "Travelling in the Future", vi: "Du lịch tương lai" }, { en: "English Speaking Countries", vi: "Các nước nói tiếng Anh" }
        ];

        const titles8 = [
            { en: "Leisure Time", vi: "Thời gian rảnh rỗi" }, { en: "Life in the Countryside", vi: "Cuộc sống nông thôn" },
            { en: "Teenagers", vi: "Thiếu niên" }, { en: "Ethnic Groups", vi: "Các dân tộc thiểu số" },
            { en: "Our Customs and Traditions", vi: "Phong tục và truyền thống" }, { en: "Lifestyles", vi: "Lối sống" },
            { en: "Environmental Protection", vi: "Bảo vệ môi trường" }, { en: "Shopping", vi: "Mua sắm" },
            { en: "Natural Disasters", vi: "Thảm họa thiên nhiên" }, { en: "Communication in the Future", vi: "Giao tiếp tương lai" },
            { en: "Science and Technology", vi: "Khoa học và công nghệ" }, { en: "Life on Other Planets", vi: "Sự sống hành tinh khác" }
        ];

        const titles9 = [
            { en: "Local Community", vi: "Cộng đồng địa phương" }, { en: "City Life", vi: "Cuộc sống thành phố" },
            { en: "Teenagers", vi: "Giới trẻ" }, { en: "Remembering the Past", vi: "Nhớ về quá khứ" },
            { en: "Our Experiences", vi: "Những trải nghiệm" }, { en: "Vietnamese Lifestyle", vi: "Lối sống Việt Nam" },
            { en: "Recipes for Life", vi: "Công thức cuộc sống" }, { en: "Tourism", vi: "Du lịch" },
            { en: "English in the World", vi: "Tiếng Anh trên thế giới" }, { en: "Space Travel", vi: "Du hành vũ trụ" },
            { en: "The Environment", vi: "Môi trường" }, { en: "Electronic Devices", vi: "Thiết bị điện tử" }
        ];

