        function createCustomUnit() {
            const title = document.getElementById('custom-title').value.trim() || `Đề Tự Tạo #${gameState.customUnits.length + 1}`;
            const vocabRaw = document.getElementById('custom-vocab').value.trim();
            const quizRaw = document.getElementById('custom-quiz').value.trim();
            const sentenceRaw = document.getElementById('custom-sentences').value.trim();

            // 1. Parse Từ vựng
            let vocabList = [];
            if (vocabRaw) {
                vocabRaw.split('\n').forEach(line => {
                    const parts = line.split('-');
                    if (parts.length >= 2) {
                        vocabList.push({
                            en: parts[0].trim(),
                            vi: parts.slice(1).join('-').trim(),
                            phonetic: "/custom/",
                            example: `Practice word: ${parts[0].trim()}`
                        });
                    }
                });
            }
            if (vocabList.length === 0) {
                vocabList = [{ en: "practice", vi: "luyện tập", phonetic: "/ˈpræktɪs/", example: "Practice makes perfect." }];
            }

            // 2. Parse Trắc nghiệm
            let quizList = [];
            if (quizRaw) {
                const blocks = quizRaw.split(/\n\s*\n/);
                blocks.forEach(block => {
                    const lines = block.split('\n').map(l => l.trim()).filter(l => l);
                    if (lines.length >= 3) {
                        const questionText = lines[0];
                        let options = [];
                        let correctText = "";
                        for (let i = 1; i < lines.length; i++) {
                            let opt = lines[i];
                            if (opt.startsWith('*')) {
                                opt = opt.substring(1).trim();
                                correctText = opt;
                            }
                            options.push(opt);
                        }
                        if (!correctText && options.length > 0) correctText = options[0];
                        quizList.push({ q: questionText, options, correctText });
                    }
                });
            }
            if (quizList.length === 0) {
                quizList = [{ q: "Chọn từ đồng nghĩa với 'study':", options: ["learn", "sleep", "play", "eat"], correctText: "learn" }];
            }

            // 3. Parse Ghép câu
            let sentenceList = [];
            if (sentenceRaw) {
                sentenceRaw.split('\n').map(s => s.trim()).filter(s => s).forEach(s => {
                    const clean = s.replace(/[.!?]$/, '');
                    const words = clean.split(/\s+/);
                    if (words.length >= 2) {
                        sentenceList.push({ scrambled: words, correct: s });
                    }
                });
            }
            if (sentenceList.length === 0) {
                sentenceList = [{ scrambled: ["English", "is", "fun"], correct: "English is fun." }];
            }

            const newId = gameState.customUnits.length + 1;
            const newUnit = {
                id: newId,
                title: title,
                vietnamese: `Đề tự tải lên (${vocabList.length} từ, ${quizList.length} câu hỏi)`,
                semester: 1,
                vocab: vocabList,
                grammar: { title: `Tổng hợp kiến thức: ${title}`, content: "Bài học được tạo tự động từ đề thi/tài liệu bạn đã cung cấp. Hãy chinh phục cả 4 chặng để làm chủ kiến thức!" },
                quiz: quizList,
                sentences: sentenceList,
                boss: { name: `Boss: ${title}`, hp: 100, questions: quizList.length }
            };

            gameState.customUnits.push(newUnit);
            saveState();
            alert("🎉 Đã tạo bài học từ đề của bạn thành công!");
            switchTab('map');
            switchGrade('custom');
        }

